@{
    ViewData["Title"] = "Delete Floor";
}

@using VillaHub.Domain.Entities
@model Floor

<div class="w-100 card border-0 p-4">
    <div class="card-header bg-success bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Delete Villa</h2>
            </div>
        </div>
    </div>
    <div class="card-body border p-4">
        <form method="post" class="row">
            <input asp-for="FloorNumber" hidden />
            <div class="col-10">
                <div class="p-3">
                    @* <div asp-validation-summary="All"></div> *@
                    <div class="form-floating py-1 col-12">
                        <input asp-for="Village.Name" disabled class="form-control border shadow" />
                        <label asp-for="Village.Name" class="ms-2"></label>
                    </div>

                    <div class="form-floating py-1 col-12">
                        <input asp-for="Villa.Name" disabled class="form-control border shadow" />
                        <label asp-for="Villa.Name" class="ms-2"></label>
                    </div>

                    <div class="form-floating py-1 col-12">
                        <input asp-for="FloorNumber" disabled class="form-control border shadow" />
                        <label asp-for="FloorNumber" class="ms-2"></label>
                    </div>

                    <div class="form-floating py-1 col-12">
                        <textarea asp-for="Description"
                                  class="form-control border shadow text-start"
                                  disabled
                                  style="height: 100px; white-space: pre-wrap; direction: ltr;"></textarea>
                        <label asp-for="Description" class="ms-2"></label>
                    </div>

                    <div class="form-floating py-1 col-12">
                        <textarea asp-for="Description_ar"
                                  class="form-control border shadow text-end"
                                  disabled
                                  style="height: 100px; white-space: pre-wrap; direction: rtl;"></textarea>
                        <label asp-for="Description_ar" class="ms-2"></label>
                    </div>



                    <div class="form-floating py-1 col-12">
                        <input asp-for="Price" disabled class="form-control border shadow" />
                        <label asp-for="Price" class="ms-2"></label>
                    </div>

                    <div class="form-floating py-1 col-12">
                        <input asp-for="Area" disabled class="form-control border shadow" />
                        <label asp-for="Area" class="ms-2"></label>
                    </div>

                    <div class="form-floating py-1 col-12">
                        <input asp-for="Capacity" disabled class="form-control border shadow" />
                        <label asp-for="Capacity" class="ms-2"></label>
                    </div>

                    <div class="row pt-2">
                        <div class="col-6 col-md-3">
                            <button type="submit" class="btn btn-danger w-100">
                                <i class="bi bi-trash-fill"></i> Delete
                            </button>
                        </div>
                        <div class="col-6 col-md-3">
                            <a asp-controller="Floor" asp-action="Index" class="btn btn-secondary w-100">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-2">
                @foreach(var img in Model.Images)
                {
                    <img src="~/images/floors/@img.Name" width="100%"
                        style="border-radius:5px;  margin-top:10px; border:1px solid #bbb9b9" />
                }
            </div> 
          
        </form>
    </div>
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}