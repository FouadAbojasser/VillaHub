@{
    ViewData["Title"] = "Create Floor";
}
@using VillaHub.Web.ViewModels.Floor
@model FloorWithVillasVM

<div class="w-100 card border-0 p-4">

    <div class="card-header bg-success bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Create Floor</h2>
            </div>
        </div>
    </div>

    <div class="card-body border p-4">
        <form method="post" class="row" enctype="multipart/form-data">
            <div class="p-3">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="row g-3">
                    <!-- Hidden VillaId to bind it properly -->
                    <input type="hidden" asp-for="Floor.VillageId" value="@Model.Village!.Id" />
                    <input type="hidden" asp-for="Floor.VillaId" value="@Model.Villa!.Id" />

                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="@Model.Village.Name" readonly class="form-control border shadow bg-dark" />
                            <label asp-for="@Model.Village.Name" class="ms-2"></label>
                            <span asp-validation-for="@Model.Village.Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="@Model.Villa.Name" readonly class="form-control border shadow bg-dark" />
                            <label asp-for="@Model.Villa.Name" class="ms-2"></label>
                            <span asp-validation-for="@Model.Villa.Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-floating">
                            <input asp-for="@Model.Floor!.FloorNumber" class="form-control border shadow" />
                            <label asp-for="@Model.Floor!.FloorNumber" class="ms-2"></label>
                            <span asp-validation-for="@Model.Floor!.FloorNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-floating">
                            <input asp-for="@Model.Floor!.Description" class="form-control border shadow" />
                            <label asp-for="@Model.Floor!.Description" class="ms-2"></label>
                            <span asp-validation-for="@Model.Floor!.Description" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="form-floating">
                            <input asp-for="@Model.Floor!.Price" class="form-control border shadow" />
                            <label asp-for="@Model.Floor!.Price" class="ms-2"></label>
                            <span asp-validation-for="@Model.Floor!.Price" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="form-floating">
                            <input asp-for="@Model.Floor!.Area" class="form-control border shadow" />
                            <label asp-for="@Model.Floor!.Area" class="ms-2"></label>
                            <span asp-validation-for="@Model.Floor!.Area" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="form-floating">
                            <input asp-for="@Model.Floor!.Capacity" class="form-control border shadow" />
                            <label asp-for="@Model.Floor!.Capacity" class="ms-2"></label>
                            <span asp-validation-for="@Model.Floor!.Capacity" class="text-danger"></span>
                        </div>
                    </div>
                    <!-- Amenities -->
                    <div class="col-12">
                        <div class="form-label mb-1 ms-2">Amenities</div>
                        <div class="form-control border shadow py-2">
                            @foreach (var amenity in Model.Amenities)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedAmenityIds"
                                           value="@amenity.Id" />
                                    <label class="form-check-label">@amenity.Name</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Amenities" class="text-danger"></span>
                    </div>
                    <!-- Floor Images Upload: full width, directly under all fields -->
                    <div class="col-12">
                        <label asp-for="@Model.Floor!.Images" class="form-label ms-2 mb-1"></label>
                        <input asp-for="@Model.Floor!.Images" type="file" multiple accept="image/*" name="FloorImages"
                               class="form-control border shadow" onchange="handleFloorImages(event)" />
                        <span id="galleryError" class="text-danger d-block pt-1" style="display: none;">You can upload up to 5 images only.</span>
                        <span asp-validation-for="@Model.Floor!.Images" class="text-danger"></span>
                        <div class="row mt-3" id="galleryPreview" style="gap: 15px;"></div>
                    </div>
                    <!-- Fullscreen Modal Carousel (unchanged) -->
                    <div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content bg-dark border-0">
                                <div class="modal-body p-0">
                                    <div id="imageCarousel" class="carousel slide" data-bs-ride="carousel">
                                        <div class="carousel-inner" id="imageCarouselInner"></div>
                                        <button class="carousel-control-prev" type="button" data-bs-target="#imageCarousel" data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon"></span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#imageCarousel" data-bs-slide="next">
                                            <span class="carousel-control-next-icon"></span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Actions: always at the bottom -->
                    <div class="col-12 col-md-6 col-lg-3 mt-3">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle"></i> Create
                        </button>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3 mt-3">
                        <a asp-controller="Floor" asp-action="Index" class="btn btn-secondary w-100">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        // =============================
        // 🔷 GALLERY UPLOAD + PREVIEW + MODAL
        // =============================
        let galleryImages = [];

            function handleFloorImages(event) {
            const files = event.target.files;
            const galleryPreview = document.getElementById("galleryPreview");
            const galleryError = document.getElementById("galleryError");

            // Clear previous previews
            galleryPreview.innerHTML = "";

            if (files.length > 5) {
                galleryError.style.display = "block";
                event.target.value = "";
                return;
            }

            galleryError.style.display = "none";
            galleryImages = []; // Reset the array

            Array.from(files).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const imageData = {
                        id: Date.now() + index,
                        src: e.target.result,
                        file: file // Keep reference to the actual file
                    };
                    galleryImages.push(imageData);

                    // Create thumbnail preview
                    const col = document.createElement("div");
                    col.className = "position-relative";
                    col.style = "max-width: 150px;";
                    col.innerHTML = `
                        <img src="${e.target.result}" class="img-thumbnail shadow w-100"
                             style="height: 100px; object-fit: cover; cursor: pointer;"
                             onclick="showFullImage(${index})" />
                        <button type="button" class="btn btn-sm btn-danger rounded-circle position-absolute top-0 end-0 m-1"
                                onclick="removeFloorImage(${imageData.id})">
                            &times;
                        </button>
                    `;
                    galleryPreview.appendChild(col);
                };
                reader.readAsDataURL(file);
            });
        }

        function updateThumbnails() {
            const previewContainer = document.getElementById("galleryPreview");
            previewContainer.innerHTML = "";

            galleryImages.forEach((img, index) => {
                const col = document.createElement("div");
                col.className = "position-relative";
                col.style = "max-width: 150px;";

                col.innerHTML = `
                    <img src="${img.src}" class="img-thumbnail shadow w-100" style="height: 100px; object-fit: cover; cursor: pointer;"
                         onclick="showFullImage(${index})" />
                    <button type="button" class="btn btn-sm btn-danger rounded-circle position-absolute top-0 end-0 m-1"
                            onclick="removeFloorImage(${img.id})">
                        &times;
                    </button>
                `;
                previewContainer.appendChild(col);
            });
        }

        function removeFloorImage(id) {
            galleryImages = galleryImages.filter(img => img.id !== id);
            updateThumbnails();
        }

        function showFullImage(startIndex) {
            const carouselInner = document.getElementById("imageCarouselInner");
            carouselInner.innerHTML = "";

            galleryImages.forEach((img, i) => {
                const div = document.createElement("div");
                div.className = "carousel-item" + (i === startIndex ? " active" : "");
                div.innerHTML = `<img src="${img.src}" class="d-block w-100" style="object-fit: contain; height: 500px;" />`;
                carouselInner.appendChild(div);
            });

            const modal = new bootstrap.Modal(document.getElementById('imageModal'));
            modal.show();

            const carousel = bootstrap.Carousel.getOrCreateInstance(document.getElementById('imageCarousel'));
            carousel.to(startIndex);
        }
    </script>

    

    <style>
        /* Make carousel controls white & bold */
        .carousel-control-prev-icon,
        .carousel-control-next-icon {
            filter: invert(1);
            background-color: rgba(255, 255, 255, 0.8);
            border-radius: 50%;
        }
    </style>
}




