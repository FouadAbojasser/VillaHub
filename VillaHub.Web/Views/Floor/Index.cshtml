
@using VillaHub.Domain.Entities
@model IEnumerable<Floor>

@{
    ViewData["Title"] = "Floors List";
}

<div class="w-100 card border-0 p-4">

    <div class="card-header bg-success bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Floors List</h2>
            </div>
        </div>
    </div>

    <div class="card-body border p-4">
        <div class="row pb-3">
            @* <div class="col-6 offset-6 text-end">
                <a asp-controller="Floor" asp-action="Create" class="btn btn-secondary">
                    <i class="bi bi-plus-circle"></i> Create New Floor
                </a>
            </div> *@
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped w-100 align-middle text-center">
                <thead>
                    <tr>
                        <th>Floor Number</th>
                        <th>Villa Name</th>
                        <th>Village Name</th>
                        <th>Description</th>
                        <th>Description Arabic</th>
                        <th>Price</th>
                        <th>Area<br /><small>(Sqm)</small></th>
                        <th>Capacity<br /><small>(Person)</small></th>
                        <th>Bookings</th>
                        <th>Amenities</th>
                        <th>Gallery</th>
                        <th>isDeleted?</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var floor in Model)
                    {
                        <tr>
                            <td>@floor.FloorNumber</td>
                            <td>@floor.Villa!.Name</td>
                            <td>@floor.Villa!.Village.Name</td>
                            <td class="text-start">@floor.Description</td>
                            <td class="text-end"  style="white-space: pre-wrap; direction: rtl;">@floor.Description_ar</td>
                            <td>@floor.Price</td>
                            <td>@floor.Area</td>
                            <td>@floor.Capacity</td>
                            <td>
                                <a href="#" class="text-decoration-none text-primary"
                                   data-bs-toggle="modal" data-bs-target="#bookingModal"
                                   onclick="loadBookingBreakdown(@floor.FloorNumber, @floor.VillaId, @floor.VillageId)">
                                    Bookings (@floor.BookingsCount)
                                </a>
                            </td>
                            <td>
                                <a href="#" class="text-decoration-none text-primary"
                                   data-bs-toggle="modal" data-bs-target="#amenityModal"
                                   onclick="loadAmenities('@floor.FloorNumber', '@floor.VillaId', '@floor.VillageId')">
                                    Amenities (@floor.Amenities.Count())
                                </a>
                            </td>
                            <td>
                                <a href="#" class="text-decoration-none text-primary" data-bs-toggle="modal" data-bs-target="#galleryModal"
                                   onclick="loadFloorGallery('@floor.FloorNumber', '@floor.VillaId', '@floor.VillageId', '@floor.Villa.Name')">
                                    Gallery (@floor.Images.Count())
                                </a>
                            </td>
                            <td>
                                @if (floor.IsDeleted)
                                {
                                    <span class="badge bg-danger px-3 py-2">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-3 py-2">No</span>
                                }   
                            <td>
                                <div class="d-inline-flex justify-content-center">
                                    <div class="btn-group" role="group">
                                        <a asp-controller="Floor" asp-action="Update"
                                           asp-route-floorNumber="@floor.FloorNumber"
                                           asp-route-villaId="@floor.VillaId"
                                           asp-route-villageId="@floor.VillageId"
                                           class="btn btn-success mx-1">
                                            <i class="bi bi-pencil-square"></i> Update
                                        </a>

                                        @if (!floor.IsDeleted)
                                        {
                                            <a asp-controller="Floor" asp-action="Delete"
                                               asp-route-floorNumber="@floor.FloorNumber"
                                               asp-route-villaId="@floor.VillaId"
                                               asp-route-villageId="@floor.VillageId"
                                               class="btn btn-danger mx-1">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Floor" asp-action="Restore"
                                               asp-route-floorNumber="@floor.FloorNumber"
                                               asp-route-villaId="@floor.VillaId"
                                               asp-route-villageId="@floor.VillageId"
                                               class="btn btn-warning mx-1">
                                                <i class="bi bi-arrow-clockwise"></i> Restore
                                            </a>
                                        }
                                        
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Booking Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Floor Bookings</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul id="bookingList" class="list-group"></ul>
            </div>
        </div>
    </div>
</div>

<!-- Amenity Modal -->
<div class="modal fade" id="amenityModal" tabindex="-1" aria-labelledby="amenityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Floor Amenities</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul id="amenityList" class="list-group"></ul>
            </div>
        </div>
    </div>
</div>

<!-- Gallery Modal -->
<div class="modal fade" id="galleryModal" tabindex="-1" aria-labelledby="galleryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Floor Gallery</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="galleryContent" class="row" style="gap: 15px;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showFullImage(imgSrc) {
            document.getElementById('modalImage').src = imgSrc;
        }

        function loadFloorGallery(floorNumber, villaId, villageId) {
            const galleryContainer = document.getElementById("galleryContent");
            galleryContainer.innerHTML = "";

            const images = @Html.Raw(Json.Serialize(Model.SelectMany(f => f.Images.Select(img => new
            {
                floorNumber = f.FloorNumber,
                villaId = f.VillaId,
                villageId = f.VillageId,
                name = img.Name
            }))));

            const filtered = images.filter(img =>
                img.floorNumber === parseInt(floorNumber) &&
                img.villaId === parseInt(villaId) &&
                img.villageId === parseInt(villageId)
            );

            if (filtered.length === 0) {
                galleryContainer.innerHTML = "<p>No images available for this floor.</p>";
                return;
            }

            filtered.forEach(img => {
                const col = document.createElement("div");
                col.className = "col-md-4 col-12 mb-3";
                col.innerHTML = `
                    <img src="/images/floors/${img.name}" class="img-thumbnail w-100 shadow-sm img-fluid"
                         style="height: 150px; object-fit: cover;" alt="Floor Image" />
                `;
                galleryContainer.appendChild(col);
            });
        }

        function loadAmenities(floorNumber, villaId, villageId) {
            const amenityList = document.getElementById("amenityList");
            amenityList.innerHTML = "";

            const floors = @Html.Raw(Json.Serialize(Model.Select(f => new {
                floorNumber = f.FloorNumber,
                villaId = f.VillaId,
                villageId = f.VillageId,
                villaName = f.Villa.Name,
                amenities = f.Amenities.Select(a => a.Name.Trim())
            })));

            const floor = floors.find(f =>
                f.floorNumber === parseInt(floorNumber) &&
                f.villaId === parseInt(villaId) &&
                f.villageId === parseInt(villageId)
            );

            if (!floor || floor.amenities.length === 0) {
                amenityList.innerHTML = "<li class='list-group-item'>No amenities available for this floor.</li>";
                return;
            }

            floor.amenities.forEach(amenity => {
                const li = document.createElement("li");
                li.className = "list-group-item";
                li.textContent = amenity;
                amenityList.appendChild(li);
            });

            document.querySelector('#amenityModal .modal-title').textContent =
                `Amenities for Floor ${floorNumber} in Villa ${floor.villaName}`;
        }

        // Booking Function
        const bookingData = @Html.Raw(Json.Serialize(Model.Select(f => new {
            floorNumber = f.FloorNumber,
            villaId = f.VillaId,
            villageId = f.VillageId,
            bookings = f.BookingsByStatus
        })));

        function loadBookingBreakdown(floorNumber, villaId, villageId) {
            const bookingList = document.getElementById("bookingList");
            bookingList.innerHTML = "";

            const floor = bookingData.find(f =>
                f.floorNumber === parseInt(floorNumber) &&
                f.villaId === parseInt(villaId) &&
                f.villageId === parseInt(villageId)
            );

            if (!floor || !floor.bookings || Object.keys(floor.bookings).length === 0) {
                bookingList.innerHTML = "<li class='list-group-item'>No bookings for this floor.</li>";
                return;
            }

            for (const [status, count] of Object.entries(floor.bookings)) {
                const li = document.createElement("li");
                li.className = "list-group-item d-flex justify-content-between align-items-center";
                li.innerHTML = `${status} <span class="badge bg-primary rounded-pill">${count}</span>`;
                bookingList.appendChild(li);
            }

            document.querySelector('#bookingModal .modal-title').textContent =
                `Bookings for Floor ${floorNumber}`;
        }
    </script>
}

