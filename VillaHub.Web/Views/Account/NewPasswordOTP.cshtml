@using VillaHub.Web.ViewModels
@model NewPasswordOTPVM

<div class="container pt-5">
    <div class="card shadow border">
        <div class="card-header bg-success bg-gradient ml-0 py-4">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="py-2 text-white">Reset Password Using OTP</h2>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-12">
                    <section>
                        <form method="post">

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-floating mb-3">
                                <input asp-for="OTP" class="form-control" aria-required="true" />
                                <label asp-for="OTP" class="form-label"></label>
                                <span asp-validation-for="OTP" class="text-danger"></span>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="NewPassword" class="form-control" />
                                <label asp-for="NewPassword" class="ms-2 text-muted"></label>
                                <span asp-validation-for="NewPassword" class="text-danger" />
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="ConfirmNewPassword" class="form-control" />
                                <label asp-for="ConfirmNewPassword" class="ms-2 text-muted">Confirm Password</label>
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger" />
                            </div>
                            <div class="d-grid gap-3">
                                <button type="submit" class="btn btn-lg btn-outline-success">Reset Password</button>
                                <a href="/" class="btn btn-lg btn-outline-secondary">Cancel</a>
                            </div>
                        </form>
                    </section>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
