@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PrivacyPolicy"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="card shadow border-0">
                <div class="card-body p-4">
                    <h1 class="mb-4 text-success">@ViewData["Title"]</h1>
                    <p class="lead">@Localizer["PrivacyIntro"]</p>

                    <h4 class="mt-4 mb-2 text-primary">1. @Localizer["InfoWeCollect"]</h4>
                    <ul>
                        <li><strong>@Localizer["PersonalInfo"]</strong></li>
                        <li><strong>@Localizer["UsageData"]</strong></li>
                        <li><strong>@Localizer["Cookies"]</strong></li>
                    </ul>

                    <h4 class="mt-4 mb-2 text-primary">2. @Localizer["HowWeUseInfo"]</h4>
                    <ul>
                        <li>@Localizer["ProvideServices"]</li>
                        <li>@Localizer["ImproveServices"]</li>
                        <li>@Localizer["Communicate"]</li>
                        <li>@Localizer["ProcessTransactions"]</li>
                        <li>@Localizer["LegalCompliance"]</li>
                    </ul>

                    <h4 class="mt-4 mb-2 text-primary">3. @Localizer["HowWeShareInfo"]</h4>
                    <ul>
                        <li>@Localizer["NoSellInfo"]</li>
                        <li>@Localizer["TrustedPartners"]</li>
                        <li>@Localizer["LegalDisclosure"]</li>
                    </ul>

                    <h4 class="mt-4 mb-2 text-primary">4. @Localizer["DataSecurity"]</h4>
                    <p>@Localizer["DataSecurityDesc"]</p>

                    <h4 class="mt-4 mb-2 text-primary">5. @Localizer["YourRights"]</h4>
                    <ul>
                        <li>@Localizer["ManagePersonalInfo"]</li>
                        <li>@Localizer["OptOutMarketing"]</li>
                    </ul>

                    <h4 class="mt-4 mb-2 text-primary">6. @Localizer["ChangesPolicy"]</h4>
                    <p>@Localizer["ChangesPolicyDesc"]</p>

                    <h4 class="mt-4 mb-2 text-primary">7. @Localizer["ContactUs"]</h4>
                    <p>@Localizer["ContactDesc"]</p>
                    <ul>
                        <li><strong>@Localizer["OwnerName"]</strong></li>
                        <li><strong>@Localizer["OwnerEmail"]</strong> <a href="mailto:fouad.abojasser@gmail.com">fouad.abojasser@gmail.com</a></li>
                    </ul>

                    <p class="text-muted mt-4">@Localizer["EffectiveDate"]: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
                </div>
            </div>
        </div>
    </div>
</div>
