@{
        ViewData["Title"] = "Home Page";
}

@using VillaHub.Web.ViewModels.Home
@model HomeVM

<style>
    .custom-carousel {
        max-height: 500px;
        overflow: hidden;
    }
    .custom-carousel .carousel-img {
        height: 25%;
        object-fit: cover;
    }
</style>

<div class="container-fluid px-0">
    <div id="carouselExampleIndicators" class="carousel slide custom-carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/home/slide1.jpg" class="d-block w-100 carousel-img img-fluid" alt="Slide 1">
            </div>
            <div class="carousel-item">
                <img src="~/images/home/slide2.jpg" class="d-block w-100 carousel-img img-fluid" alt="Slide 2">
            </div>
            <div class="carousel-item">
                <img src="~/images/home/slide3.jpg" class="d-block w-100 carousel-img img-fluid" alt="Slide 3">
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>

<div class="container-fluid px-0">
    <form method="post" asp-action="GetVillagesByDate">
        <div class="d-flex flex-column flex-md-row flex-wrap gap-3 px-3 px-md-5 m-lg-4 m-0 justify-content-center">
            <div class="flex-fill">
                <label asp-for="minPrice" class="form-label mb-1"></label>
                <input asp-for="minPrice" type="number" min="0" class="form-control" placeholder="≥ Min" />
                <span asp-validation-for="minPrice" class="text-danger"></span>
            </div>
            <div class="flex-fill">
                <label asp-for="maxPrice" class="form-label mb-1"></label>
                <input asp-for="maxPrice" type="number" min="0" class="form-control" placeholder="≤ Max" />
                <span asp-validation-for="maxPrice" class="text-danger"></span>
            </div>
            <div class="flex-fill">
                <label asp-for="CheckInDate" class="form-label mb-1"></label>
                <input asp-for="CheckInDate"
                       type="date"
                       class="form-control w-100"
                       min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
            </div>
            <div class="flex-fill">
                <label asp-for="NumberOfNights" class="form-label mb-1"></label>
                <select class="form-select w-100" asp-for="NumberOfNights">
                    @for (var i = 1; i < 11; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
                <span asp-validation-for="NumberOfNights" class="text-danger"></span>
            </div>
            <div class="d-flex align-items-end">
                <button type="button" onclick="fnLoadVillaList()" class="btn btn-success w-100">
                    <i class="bi bi-search"></i> &nbsp; Check Availability
                </button>
            </div>
        </div>
    </form>
</div>

<div class="container-fluid px-0">
    <div class="border-bottom pb-4 px-3 px-md-5 my-5">
        <h2 class="text-success mb-2">Floors</h2>
        <partial name="_FloorList" model="@Model" />
    </div>
    <div class="border-bottom pb-4 px-3 px-md-5 my-5">
        <h2 class="text-primary mb-2">Villas</h2>
        <partial name="_VillaList" model="@Model" />
    </div>
    <div class="px-3 px-md-5 my-5">
        <h2 class="text-warning mb-2">Villages</h2>
        <partial name="_VillageList" model="@Model" />
    </div>
</div>

@section scripts{
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fnLoadVillaList()
        {
            $('.spinner').show();
            var objData = {
                checkInDate: $("#CheckInDate").val(),
                NumberOfNights: $("#NumberOfNights").val(),
                minPrice: $("#minPrice").val(),
                maxPrice: $("#maxPrice").val(),
            };
            $.ajax({
                type: "POST",
                data: objData,
                url: "@Url.Action("CheckFloorAvailability", "Home")",
                success: function (data) {
                    $("#FloorList").empty();
                    $("#FloorList").html(data);
                    $('.spinner').hide();
                },
                failure: function (response) {
                    $('.spinner').hide();
                    alert(response.responseText);
                },
                error: function (response) {
                    $('.spinner').hide();
                    alert(response.responseText);
                }
           });
        }
    </script>
}