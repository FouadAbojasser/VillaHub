@using VillaHub.Web.ViewModels.Home
@model HomeVM

<style>
    .custom-carousel {
        max-height: 500px; /* Adjust to your desired height */
        overflow: hidden;
    }

    .custom-carousel .carousel-img {
        height: 25%;
        object-fit: cover; /* Keeps aspect ratio and fills container */
    }
</style>

<div>
    <div id="carouselExampleIndicators" class="carousel slide custom-carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/home/slide1.jpg" class="d-block w-100 carousel-img" alt="Slide 1">
            </div>
            <div class="carousel-item">
                <img src="~/images/home/slide2.jpg" class="d-block w-100 carousel-img" alt="Slide 2">
            </div>
            <div class="carousel-item">
                <img src="~/images/home/slide3.jpg" class="d-block w-100 carousel-img" alt="Slide 3">
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>

<div>
    @* في حال استخدام مكتبة مساعدة  *@
    @* data-ajax-method="post"
    data-ajax="true"
    data-ajax-mode="replace" data-ajax-update="#VillageList" *@

    <form method="post" asp-action="GetVillagesByDate">
        
        <div class="d-flex flex-column flex-md-row flex-wrap gap-3 px-lg-5 m-lg-4 m-sm-0 px-sm-0 justify-content-center">
           
            <div class="flex-fill">
                <label asp-for="PriceRange" class="form-label mb-1"></label>
                <input asp-for="PriceRange" class="form-control w-100" />
                <span asp-validation-for="PriceRange" class="text-danger"></span>
            </div>

            <div class="flex-fill">
                <label asp-for="CheckInDate" class="form-label mb-1"></label>
                <input asp-for="CheckInDate" type="date" class="form-control w-100" />
                <span asp-validation-for="CheckInDate" class="text-danger"></span>
            </div>

            <div class="flex-fill">
                <label asp-for="NumberOfNights" class="form-label mb-1"></label>
                <select asp-for="NumberOfNights" class="form-select w-100">
                    @for (var i = 1; i < 11; i++)
                    {
                        <option value="@i" selected="@(Model.NumberOfNights == i ? "selected" : null)">
                            @i
                        </option>
                    }
                </select>
            </div>


            <div class="d-flex align-items-end">
                <button type="button" onclick="fnLoadVillaList()" class="btn btn-success w-100">
                    <i class="bi bi-search"></i> &nbsp; Check Availability
                </button>
            </div>

        </div>
    </form>
</div>


<div>
    <partial name="_VillageList" model="@Model" />
</div>

@section scripts{
    <script>
        function fnLoadVillaList()
        {
            $('.spinner').show();
            var objData = {
                checkInDate: $("#CheckInDate").val(),
                nights: $("#NumberOfNights").val(),
                price: $("#PriceRange").val()
            };

            $.ajax({
                type: "POST",
                data:objData,
                url: "@Url.Action("GetVillagesByDate", "Home")",
                success: function (data) {
                    $("#VillageList").empty();
                    $("#VillageList").html(data);
                    $('.spinner').hide();
                },
                failure: function (response) {
                    $('.spinner').hide();
                    alert(response.responseText);
                },
                error: function (response) {
                    $('.spinner').hide();
                    alert(response.responseText);
                }
           });
        }
    </script>
}