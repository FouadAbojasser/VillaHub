@using System.Globalization
@using VillaHub.Web.ViewModels.Home
@model HomeVM

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<div id="FloorList">

    @* <div class="mb-3 text-end" id="compare-button-container" style="display:none;">
        <button class="btn btn-primary" id="compare-btn">
            <i class="bi bi-columns-gap"></i> Compare
        </button>
    </div> *@

    <div class="row px-lg-5 m-lg-4 m-sm-0 px-sm-0" style="--bs-gutter-x:0">

        @foreach (var floor in Model.Floors!)
        {
           
            <div class="p-4 col-md-12 col-lg-6">

                <div class="row g-0 border rounded shadow-sm h-100" style="overflow: hidden;">

                    <!-- Floor Image Carousel -->
                    <div class="col-md-4 d-flex flex-column align-items-center justify-content-start p-2">
                       
                        <div class="position-relative w-100 mb-3" style="height: 150px; border-radius: 5px; overflow: hidden;">
                            @foreach (var image in floor.Images)
                            {
                                <img src="@Url.Content($"~/images/floors/{image.Name}")"
                                     alt="Floor @floor.FloorNumber in Villa @floor.VillaId, Village @floor.VillageId"
                                     class="img-fluid floor-image"
                                     style="width: 100%; height: 100%; object-fit: cover; position: absolute;  top: 0; left: 0;  transition: opacity 1s ease-in-out;"
                                     data-bs-toggle="modal"
                                     data-bs-target="#imageModal"
                                     data-fullimage="@Url.Content($"~/images/floors/{image.Name}")" />
                            }
                        </div>

                        @if (Model.CheckInDate != default && Model.CheckInDate > DateOnly.FromDateTime(DateTime.Now))
                        {
                        
                            @if (floor.isAvailable)
                            {
                                if (floor.isInPriceRange)
                                {
                                    
                                    <a asp-controller="Booking" asp-action="FinalizeBooking"
                                        asp-route-villageId="@floor.VillageId"
                                        asp-route-villaId="@floor.VillaId"
                                        asp-route-floorNumber="@floor.FloorNumber"
                                        asp-route-checkInDate="@Model.CheckInDate.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture)"
                                        asp-route-noOfNights="@Model.NumberOfNights"
                                        class="btn btn-success form-control w-100 mt-auto">
                                        <i class="bi bi-calendar-check"></i>
										@Localizer["BookNow"]
                                    </a>


                                    @* <div class="form-check mt-2 d-flex justify-content-center">
                                        <input class="form-check-input me-2" type="checkbox"
                                               id="compare-@floor.FloorNumber-@floor.VillaId-@floor.VillageId"
                                               value="@floor.FloorNumber" />
                                        <label class="form-check-label"
                                               for="compare-@floor.FloorNumber-@floor.VillaId-@floor.VillageId">
                                            Add to Compare
                                        </label>
                                    </div> *@
                                }
                                else
                                {
                                    <a class="btn btn-outline-warning disabled form-control w-100 mt-auto">
                                        <i class="bi bi-currency-dollar"></i>
										@Localizer["OutOfBudget"]
                                    </a>
                                }
                            }
                            else
                            {
                                <a class="btn btn-outline-danger disabled form-control w-100 mt-auto">
                                    <i class="bi bi-calendar-check"></i>
									@Localizer["NotAvailable"]
                                </a>
                            }
                        }
                    </div>



                    <!-- Floor Info -->
                    <div class="col-md-8 d-flex flex-column justify-content-between p-3">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <h5 class="text-warning mb-0" style="font-size: 1.5rem;">
                                        @floor.FloorNumber - @floor.Villa.Name - @floor.Village.Name
                                    </h5>

                                    @if (floor.Reviews.Any())
                                    {
                                        var average = floor.Reviews.Average(r => r.Rate);
                                        <div class="small text-muted">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= Math.Floor(average))
                                                {
                                                    <i class="bi bi-star-fill text-warning"></i>
                                                }
                                                else if (i - average <= 0.5)
                                                {
                                                    <i class="bi bi-star-half text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-warning"></i>
                                                }
                                            }
                                            <span class="ms-2">(@average.ToString("0.0"))</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">@Localizer["NoRatingsAvailable"]</div>
                                    }
                                </div>

                                
                                <button type="button" class="btn btn-sm btn-outline-success"
                                        data-bs-toggle="modal" data-bs-target="#exampleModal-@($"{floor.VillageId}-{floor.VillaId}-{floor.FloorNumber}")">
                                    @Localizer["Details"]
                                </button>

                            </div>

                            <div class="mb-2 text-muted" style="font-size: 0.9rem;">
                                @if(floor.Description!.Length > 100)
                                {
                                    @(
                                        CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ?
                                        @Html.Raw(floor.Description_ar!.Substring(0, 100))
                                            : @Html.Raw(floor.Description.Substring(0, 100))
                                    )

                                    <span>. . .</span>
                                }
                                else
                                {
                                    @(
                                        CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ?
                                        @Html.Raw(floor.Description_ar)
                                        : @Html.Raw(floor.Description)
                                     )
                                }
                            </div>
                        </div>


                        <!-- Metrics and Price -->
                        <div class="row align-items-end pt-2">
                            <div class="col-6">
                                @if (floor is not null)
                                {
                                    <div class="small">
                                        @* <div>No. of Villas: <strong>@floor.Villas.Count</strong></div> *@
                                        <div>@Localizer["CapacityAvg"]: <strong>@floor.Capacity</strong> @Localizer["persons"]</div>
                                        <div>@Localizer["AreaAvg"]: <strong>@floor.Area</strong> @Localizer["sqm"]</div>
                                    </div>
                                }
                            </div>

                            <div class="col-6 @(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "text-start" : "text-end")">
                                <div class="text-warning fw-bold @(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "text-start" : "text-end")" style="font-size: 1rem; line-height: 1.4;">
                                    @Localizer["PricePerNight"] <br />
                                    <span style="border-bottom: 1px solid #ff6a00; display: inline-block;">
                                        @if (floor is not null)
                                        {
                                            @floor.Price.ToString("c", new System.Globalization.CultureInfo("en-US"))
                                        }
                                        else
                                        {
                                            <span>@Localizer["NoPricingData"]</span>
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="modal fade" id="exampleModal-@($"{floor!.VillageId}-{floor.VillaId}-{floor.FloorNumber}")" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl" style="border: 1px solid #aaa; border-radius:7px;">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h1 class="modal-title fs-3 text-success" id="exampleModalLabel">
                                @Localizer["FloorDetails"] – @Localizer["Floor"]: @floor.FloorNumber, @Localizer["Villa"]: @floor.Villa.Name, @Localizer["Village"]: @floor.Village.Name
                            </h1>
                        </div>

                        <div class="modal-body m-0">
                            <partial name="_FloorDetail" model="@floor" />
                        </div>

                        <div class="modal-footer">

                            <a asp-area="Customer"
                               asp-controller="Review"
                               asp-action="FloorReview"
                               asp-route-villageId="@floor.VillageId"
                               asp-route-villaId="@floor.VillaId"
                               asp-route-floorNumber="@floor.FloorNumber"
                               target="_blank"
                               class="btn btn-outline-info">
								<i class="bi bi-chat-dots"></i> @Localizer["CustomersReviews"]
                            </a>

                          @*<button type="button"
                                    class="btn btn-outline-info"
                                    onclick="window.open('@Url.Action("FloorReview", "Review", new { area = "Customer", villageId = floor.VillageId, villaId = floor.VillaId, floorNumber = floor.FloorNumber })', '_blank')">
                                <i class="bi bi-chat-dots"></i> Customers Reviews
                            </button> *@


                            <button onclick="window.open('https://www.google.com/maps?q=@floor.Villa.Latitude,@floor.Villa.Longitude', '_blank')"
                                    type="button" class="btn btn-outline-primary">
								<i class="bi bi-google"></i> @Localizer["ViewOnGoogleMaps"]
                            </button>

                            <a asp-controller="Home"
                               asp-action="GeneratePPTExport"
                               asp-route-villageId="@floor.VillageId"
                               asp-route-villaId="@floor.VillaId"
                               asp-route-floorNumber="@floor.FloorNumber"
                               class="btn btn-outline-warning">
								<i class="bi bi-file-earmark-ppt"></i> @Localizer["DownloadPPT"]
                            </a>

                            <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">@Localizer["Close"]</button>

                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section scripts{

    <script>
                  document.addEventListener("DOMContentLoaded", function () {
            // More specific selector that matches your checkbox structure
            const compareCheckboxes = document.querySelectorAll('input[type="checkbox"][id^="compare-"]');
            const compareContainer = document.getElementById('compare-button-container');
            const compareBtn = document.getElementById('compare-btn');

            function updateCompareButton() {
                const checked = document.querySelectorAll('input[type="checkbox"][id^="compare-"]:checked');
                console.log('Checked boxes:', checked.length, checked); // Enhanced debug

                if (checked.length >= 2 && checked.length <= 3) {
                    console.log('Showing compare button');
                    compareContainer.style.display = "block";
                } else {
                    console.log('Hiding compare button');
                    compareContainer.style.display = "none";
                }
            }

            // Use event delegation in case checkboxes are dynamically loaded
            document.addEventListener('change', function(e) {
                if (e.target.matches('input[type="checkbox"][id^="compare-"]')) {
                    updateCompareButton();
                }
            });

            // Initialize
            updateCompareButton();

            compareBtn.addEventListener('click', function () {
                const selectedValues = Array.from(
                    document.querySelectorAll('input[type="checkbox"][id^="compare-"]:checked')
                ).map(cb => cb.value);

                console.log('Selected values:', selectedValues); // Debug

                if (selectedValues.length >= 2 && selectedValues.length <= 3) {
                    const url = `/Home/Compare?floors=${selectedValues.join(",")}`;
                    window.location.href = url;
                }
            });
        });
    </script>

}


