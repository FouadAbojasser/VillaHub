
@using VillaHub.Domain.Entities
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model Floor



<div class="row">

    <div class="col-12 col-md-5">
        <div id="floorImagesCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                @{
                    var index = 0;
                    foreach (var image in Model.Images)
                    {
                        var activeClass = index == 0 ? "active" : "";
                        <div class="carousel-item @activeClass">
                            <img src="~/images/floors/@image.Name" class="d-block w-100" style="border-radius:10px;" />
                        </div>
                        index++;
                    }
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#floorImagesCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#floorImagesCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>


    <div class="col-12 col-md-7">
        <div class="row p-2">
            <div class="col-12">
                <div class="mb-2">
                    <p class="card-title text-warning my-2" style="font-size:xx-large">@Localizer["Floor"]: @Model.FloorNumber - @Localizer["Villa"]: @Model.Villa.Name</p>
                    @if (Model.Reviews.Any())
                    {
                        var average = Model.Reviews.Average(r => r.Rate);
                        <div class="small text-muted">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Floor(average))
                                {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }
                                else if (i - average <= 0.5)
                                {
                                    <i class="bi bi-star-half text-warning"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-warning"></i>
                                }
                            }
                            <span class="ms-2">(@average.ToString("0.0"))</span>
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted">@Localizer["NoRatingsAvailable"]</div>
                    }
                </div>

                <p class="card-text" style="font-size: large; line-height: 1.8;">
                    @(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft 
                    ? @Html.Raw(Model.Description_ar)
                    : @Html.Raw(Model.Description))
                </p>

                @if (Model.Amenities != null && Model.Amenities.Count() > 0)
                {
                    <p class="h5 text-white">@Localizer["FloorAmenities"]</p>
                    <ul>
                        @if(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft)
                        {
                            @foreach (var amenity in Model.Amenities)
                            {
                                <li>@amenity.Name_ar</li> //Arabic
                            }
                        }
                        else
                        {
                            @foreach (var amenity in Model.Amenities)
                            {
                                <li>@amenity.Name</li>
                            }
						}
                        
                    </ul>
                }
            </div>
        </div>
        <div class="row col-12">
            <span class="p-0 pt-3 m-0 @(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "text-start" : "text-end")">
                <span class="float-right">@Localizer["MaxOccupancy"]: @Model.Capacity  @Localizer["adults"] </span><br />
                <span class="float-right pt-1">@Localizer["VillaSize"]:  @Model.Area  @Localizer["sqft"]</span><br />
                <p class="text-warning font-weight-bold pt-1">
                    
                    <span>
                        @Model.Price.ToString("c", new System.Globalization.CultureInfo("en-US")) / @Localizer["night"]
                    </span>
                </p>
            </span>
        </div>
    </div>
</div>