@using VillaHub.Domain.Entities
@model Villa

<div class="row">
    <div class="col-12 col-md-5">
        <img src="~/images/villas/@Model.MainImg" style="border-radius:10px;" width="100%" />
    </div>
    <div class="col-12 col-md-7">
        <div class="row p-2">
            <div class="col-12">
                <p class="card-title text-warning" style="font-size:xx-large">@Model.Name</p>
                <p class="card-text" style="font-size:large">
                    @Html.Raw(Model.Description)
                </p>
                @if (Model.Amenities != null && Model.Amenities.Count() > 0) 
                {
                    <p class="h5 text-white">Villa Amenities</p>
                    <ul>
                        @foreach (var amenity in Model.Amenities)
                        {
                            <li>@amenity.Name</li>
                        }
                    </ul>
                } 
            </div>
        </div>
        <div class="row col-12">
            <span class="text-end p-0 pt-3 m-0">
                <span class="float-right">Max Occupancy : @Model.Capacity  adults </span><br />
                <span class="float-right pt-1">Villa Size : @Model.Area sqft</span><br />
                <p class="text-warning font-weight-bold pt-1">
                    USD
                    <span style=" #ff6a00">
                        @if (Model.Floors != null && Model.Floors.Any(f => f.Price != null))
                        {
                            @Model.Floors.Where(f => f.Price != null).Average(f => f.Price!).ToString("c")
                        }
                        else
                        {
                            <span>No floor pricing data</span>
                        }
                        / night
                    </span>
                </p>
            </span>
        </div>
    </div>
</div>