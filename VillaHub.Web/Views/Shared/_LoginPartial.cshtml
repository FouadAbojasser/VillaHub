@using Microsoft.AspNetCore.Identity
@using VillaHub.Domain.Entities
@inject UserManager<ApplicationUser> UserManager

@using System.Globalization
@{
    var culture = CultureInfo.CurrentUICulture.Name;
    var dir = culture.StartsWith("ar-AE") ? "rtl" : "ltr";
}

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer


@{
    var currentUser = User?.Identity is not null && User.Identity.IsAuthenticated
        ? await UserManager.GetUserAsync(User)
        : null;
    var avatar = string.IsNullOrEmpty(currentUser?.ImageUrl)
        ? Url.Content("~/images/others/default-user.png")
        : Url.Content("~/images/users/" + currentUser.ImageUrl);
}

@if (User?.Identity is not null && User.Identity.IsAuthenticated)
{
    <!-- Desktop / Tablet -->
    <ul class="navbar-nav d-none d-md-flex nav-login">
        <li class="nav-item d-flex align-items-center">
            <img src="@avatar" alt="User Avatar"
                 class="rounded-circle me-4"
                 style="width:30px; height:30px; object-fit:cover;" />
            <a class="nav-link mb-0"
               asp-action="Update"
               asp-controller="User"
               asp-route-id="@currentUser!.Id">
                @Localizer["Hello"] @User.Identity!.Name
            </a>
            <a class="nav-link ms-3 mb-0"
               asp-area="Identity"
               asp-controller="Account"
               asp-action="Logout">
                @Localizer["Logout"]
            </a>
        </li>
    </ul>

    <!-- Mobile: Dropdown menu -->
    <ul class="navbar-nav d-md-none nav-login">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="@avatar" alt="User Avatar"
                     class="rounded-circle me-2"
                     style="width:30px; height:30px; object-fit:cover;" />
                
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                <li>
                    <a class="dropdown-item"
                       asp-action="Update"
                       asp-controller="User"
                       asp-route-id="@currentUser!.Id">
                        @Localizer["Hello"] @User.Identity!.Name
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-area="Identity"
                       asp-controller="Account"
                       asp-action="Logout">
                        @Localizer["Logout"]
                    </a>
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-controller="Account" asp-action="Register"> @Localizer["Register"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-controller="Account" asp-action="Login"> @Localizer["Login"]</a>
        </li>
    </ul>
}
