

@using VillaHub.Application.Common.Utility
@using VillaHub.Domain.Entities
@model Booking

@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"];
}

@{
	var isRTL = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}

<div class="p-4 mt-0 mt-lg-4">
    <div class="row" style="border: 1px solid #aaa;">

        <div class="col-12 col-lg-6 p-4 2 mt-2 mt-md-0">
            <div class="row p-1 " style="border-radius:20px; ">
                <div class="col-6">
                    <h3 class="text-success">@Localizer["BookedFloorDetails"]</h3>
                </div>
                <div class="col-6 @(isRTL ? "text-start" : "text-end")">
                    <a class="btn btn-secondary my-2"
                       asp-controller="Booking" asp-action="Index" asp-route-status=@SD.StatusApproved>
                        @if (isRTL)
                        {
                          <span> @Localizer["BackToBookings"]</span><i class= "bi bi-arrow-right-circle me-2"></i>

                        }
                        else
                        {
                          <i class="bi bi-arrow-left-circle me-2"></i><span calss="mx-2">@Localizer["BackToBookings"]</span>  
                        }
                       
					</a>
                </div>
                <hr />

                <partial name="_FloorDetail" model="@Model.Floor" />

                <hr />

               
                <div class="@(isRTL ? "text-start" : "text-end")">
                    <h4 class="text-danger font-weight-bold">
                        @Localizer["BookingTotal"] :
                        @{
                            var culture = new System.Globalization.CultureInfo("en-US");
                            culture.NumberFormat.CurrencyPositivePattern = 1; // 0=$n, 1=n$, 2=$ n, 3=n $
                        }
                        <span style="border-bottom:1px solid #ff6a00;">
                            @Model.TotalCost.ToString("c", culture)
                        </span>
                    </h4>
                </div>

                <hr class="mt-3"/>

                <form method="post">
                    <div class="row pt-1 mb-3 " style="border-radius:20px; ">
                        <div class="col-12 text-center">

                            @if (Model.IsPaymentSuccessful == true)
                            {
                                <button asp-controller="Booking" asp-action="GenerateInvoice" asp-route-bookingId="@Model.Id"
                                        asp-route-downloadType="word" type="submit"
                                       class="btn btn-sm btn-secondary my-1">
                                        <span>@Localizer["GenerateInvoiceWord"]</span>
                                        <i class="bi bi-file-earmark-word"></i>
                                </button>

                                <button asp-controller="Booking" asp-action="GenerateInvoice" asp-route-bookingId="@Model.Id"
                                        asp-route-downloadType="pdf" type="submit"
                                        class="btn btn-sm btn-secondary my-1">
                                        <span>@Localizer["GenerateInvoicePDF"]</span>
                                        <i class="bi bi-file-earmark-pdf"></i>
                                </button>
                            }
                            
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-12 col-lg-6 p-4 2 mt-4 mt-md-0" style="@(isRTL ? "border-right" : "border-left"):1px solid #aaa">

            <form method="post">
                <input asp-for="Id" hidden />
                <input asp-for="FloorNumber" hidden />
                <input asp-for="VillaId" hidden />
                <input asp-for="VillageId" hidden />
                <input asp-for="UserId" hidden />
                <input asp-for="CheckInDate" hidden />

                <input asp-for="CheckOutDate" hidden />
                <input asp-for="Nights" hidden />
                <div class="row pt-1 mb-3 " style="border-radius:20px; ">
                    <div class="col-6">
                        <h3 class="text-success">@Localizer["BookingDetails"]</h3>
                    </div>
                    <div class="col-6">
                        @if ((Model.Status == SD.StatusApproved || Model.Status == SD.StatusPending)
                                                && (User.IsInRole(SD.Role_SuperAdmin) || User.IsInRole(SD.Role_Customer)))
                        {
                            <button type="submit" asp-controller="Booking" asp-action="BookingCancel"
                            class="btn btn-sm btn-outline-danger form-control my-1">
                                &nbsp;
                                <span> @Localizer["CancelBooking"] </span> <i class="bi bi-x-circle @(isRTL?"me-3":"ms-3")"></i>
                            </button>
                        }
                    </div>
                </div>
                <div class="row">

                    <div class="form-group pt-2 col-6">
                        <label asp-for="Name" class="text-warning mb-1">@Localizer["Name"]</label>
                        <input asp-for="Name" class="form-control" />
                    </div>

                    <div class="form-group pt-2 col-6">
                        <label asp-for="Phone" class="text-warning mb-1">@Localizer["PhoneNo"]</label>
                        <input asp-for="Phone" class="form-control @(isRTL ? "text-end" : "text-start")"
                               style="direction:ltr; text-align:left;" />
                    </div>

                    <div class="form-group pt-2 col-6">
                        <label asp-for="Email" class="text-warning mb-1">@Localizer["Email"]</label>
                        <input asp-for="Email" class="form-control" />
                    </div>

                    <div class="form-group pt-2 col-6">
                        <label asp-for="Nights" class="text-warning mb-1">@Localizer["NoOfNights"]</label>
                        <input asp-for="Nights" disabled class="form-control" />
                    </div>

                    <div class="form-group pt-2 col-6">
                        <label asp-for="Status" class="text-warning mb-1">@Localizer["Status"]</label>
                        <input asp-for="Status" disabled class="form-control" />
                    </div>

                    <div class="form-group pt-2 col-6">
                        <label asp-for="BookingDate" class="text-warning mb-1">@Localizer["BookingDate"]</label>
                        <input class="form-control @(isRTL ? "text-end" : "text-start")"
                               style="direction:@(isRTL ? "rtl" : "ltr"); text-align:right;"
                               value="@Model.BookingDate.ToString("yyyy/MM/dd HH:mm")" disabled />
                    </div>


                    <div class="form-group pt-2 col-6">
                        <label asp-for="CheckInDate" class="text-warning mb-1">@Localizer["CheckInDate"]</label>
                        <input asp-for="CheckInDate" disabled class="form-control @(isRTL ? "text-end" : "text-start")"
                               style="direction:rtl; text-align:left;" />
                    </div>

                    <div class="form-group pt-2 col-6">
                        <label class="text-warning mb-1">@Localizer["ActualCheckInDate"]</label>
                        @if (Model.ActualCheckInDate == default)
                        {
                            <input disabled class="form-control" placeholder="" />
                        }
                        else
                        {
                            <input class="form-control @(isRTL ? "text-end" : "text-start")"
                                   style="@(isRTL ? "direction:rtl;" : "direction:ltr;")"
                                   value="@Model.ActualCheckInDate.ToString("yyyy/MM/dd HH:mm")" disabled />
                        }
                    </div>



                    <div class="form-group pt-2 col-6">
                        <label asp-for="CheckOutDate" class="text-warning mb-1">@Localizer["CheckOutDate"]</label>
                        <input asp-for="CheckOutDate" disabled class="form-control" />
                    </div>


                    <div class="form-group pt-2 col-6">
                        <label class="text-warning mb-1">@Localizer["ActualCheckOutDate"]</label>
                        @if (Model.ActualCheckOutDate == default)
                        {
                            <input disabled class="form-control" placeholder="" />
                        }
                        else
                        {
                            <input class="form-control @(isRTL ? "text-end" : "text-start")"
                                   style="@(isRTL ? "direction:rtl;" : "direction:ltr;")"
                                   value="@Model.ActualCheckOutDate.ToString("yyyy/MM/dd HH:mm")" disabled />
                        }
                    </div>


                    @* @if (Model.Status == SD.StatusApproved && User.IsInRole(SD.Role_SuperAdmin))
                    {
                        <div class="form-group pt-2 col-6">
                            <label class="text-danger" asp-for="VillaNumber"></label>

                            <select class="form-select" asp-for="VillaNumber">
                                @foreach (var item in Model.VillaNumbers)
                                {
                                    <option value="@item.Villa_Number">@item.Villa_Number</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input asp-for="VillaNumber" hidden />
                        @if (Model.Status == SD.StatusCheckedIn || Model.Status == SD.StatusCompleted)
                        {
                            <div class="form-group pt-2 col-6">
                                <label class="text-warning">Villa Number</label>
                                <input asp-for="VillaNumber" disabled class="form-control" />
                            </div>
                        }
                    } *@

                    @* @if (Model.IsPaymentSuccessful && User.IsInRole(SD.Role_SuperAdmin)) *@
                    @* Remove Model.IsPaymentSuccessful to see strip data for all types of bookings *@

                    @if (User.IsInRole(SD.Role_SuperAdmin))
                    {
                        <div class="form-group pt-2 col-6">
                            <label class="text-warning">Stripe PaymentIntent Id</label>
                            <input asp-for="StripePaymentIntentId" disabled class="form-control" />
                        </div>

                        <div class="form-group pt-2 col-6">
                            <label class="text-warning">Stripe Session Id</label>
                            <input asp-for="StripeSessionId" disabled class="form-control" />
                        </div>
                    }


                    <div class="form-group pt-2 col-6">
                        <label class="text-warning mb-1">@Localizer["PaymentDate"]</label>
                        @if (Model.PaymentDate == default)
                        {
                            <input disabled class="form-control" placeholder="" />
                        }
                        else
                        {
                            <input class="form-control @(isRTL ? "text-end" : "text-start")"
                                   style="@(isRTL ? "direction:rtl;" : "direction:ltr;")"
                                   value="@Model.PaymentDate.ToString("yyyy/MM/dd HH:mm")" disabled />
                        }
                    </div>
                    

                    @* <div class="form-group pt-2 col-6">
                        <label class="text-warning">Status</label>
                        <input asp-for="Status" disabled class="form-control" />
                    </div> *@

                </div>

                <div class="form-group pt-2 pt-md-4">
                    @if (User.IsInRole(SD.Role_SuperAdmin))
                    {
                        @if (Model.Status == SD.StatusApproved)
                        {
                            <button type="submit" asp-controller="Booking" asp-action="BookingCheckIn"
                                    class="btn btn-warning form-control my-1">
                                <i class="bi bi-check2-square"></i> &nbsp; Check In
                            </button>
                        }

                        @if (Model.Status == SD.StatusCheckedIn)
                        {
                            <button type="submit" asp-controller="Booking" asp-action="BookingCheckOut"
                                    class="btn btn-success form-control my-1">
                                <i class="bi bi-clipboard2-check"></i> &nbsp; Check Out / Complete Booking
                            </button>
                        }
                    }

                    @if (Model.Status == SD.StatusPending && Model.Floor.isAvailable && User.IsInRole(SD.Role_Customer))
                    {
                        <button type="submit" asp-controller="Booking" asp-action="FinalizeBooking"
                                class="btn btn-success form-control">
							@Localizer["CompleteBooking"]
                        </button>
                       
                    }
                    
                    
                </div>
            </form>

            @if (User.IsInRole(SD.Role_Customer) && Model.Status == SD.StatusCompleted)
            {
                <div id="customerReviewSection">
                    <partial name="_AddCustomerReview" model="@Model" />
                </div>
            }

        </div>
    </div>
</div>

@section scripts {
<script>
    document.querySelectorAll('#starRating i').forEach(star => {
    star.addEventListener('click', function () {
        const value = this.getAttribute('data-value');
        document.getElementById('ratingValue').value = value;

        // Highlight stars
        document.querySelectorAll('#starRating i').forEach(s => {
            if (s.getAttribute('data-value') <= value) {
                s.classList.remove('bi-star');
                s.classList.add('bi-star-fill');
                s.style.color = '#ffc107';
            } else {
                s.classList.add('bi-star');
                s.classList.remove('bi-star-fill');
                s.style.color = '#ccc';
            }
        });
    });
    });
</script>

}

