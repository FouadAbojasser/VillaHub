@using VillaHub.Domain.Entities
@model IEnumerable<Villa>

<div class="w-100 card border-0 p-4">
    <div class="card-header bg-success bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Villas List</h2>
            </div>
        </div>
    </div>
    <div class="card-body border p-4">
        <div class="row pb-3">
            <div class="col-6 offset-6 text-end">
                <a asp-controller="Villa" asp-action="Create" class="btn btn-secondary">
                    <i class="bi bi-plus-circle"></i> Create New Villa
                </a>
            </div>
        </div>

        <table class="table table-bordered table-striped text-center">
            <thead>
                <tr>
                    <th class ="align-content-center">Image</th>
                    <th class="align-content-center">Name</th>
                    <th class ="align-content-center">Village</th>
                    <th class ="align-content-center">Description</th>
                    <th class ="align-content-center">Number Of Floors</th>
                    <th class="align-content-center">Area<h6><small>(Sqm)</small></h6></th>
                    <th class="align-content-center">Capacity <h6><small>(Person)</small></h6></th>
                    <th class="align-content-center">Amenities</th>
                    <th class="align-content-center">Location</th>
                    <th class="align-content-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var villa in Model)
                {
                    <tr>
                        <td class="align-content-center">
                            @if (!string.IsNullOrEmpty(villa.MainImg))
                            {
                                var imagePath = Url.Content($"~/images/villas/" + villa.MainImg);
                                <img src="@imagePath"
                                     alt="Villa Image"
                                     style="width: 100px; height: auto; cursor: pointer;"
                                     class="img-thumbnail"
                                     data-bs-toggle="modal"
                                     data-bs-target="#imageModal"
                                     onclick="showFullImage('@imagePath')" />
                            }
                            else
                            {
                                <span class="text-muted">No image</span>
                            }
                        </td>
                        <td class="align-content-center">@villa.Name</td>
                        <td class="align-content-center">@villa.Village!.Name</td>
                        <td class="text-start">@villa.Description</td>
                        <td class="align-content-center">@villa.Floors.Count()</td>
                        <td class="align-content-center">@villa.Area</td>
                        <td class="align-content-center">@villa.Capacity</td>
                        <td class="align-content-center">
                            <a href="#" class="text-decoration-none text-primary"
                               data-bs-toggle="modal" data-bs-target="#villaAmenityModal"
                               onclick="loadVillaAmenities('@villa.Id')">
                                Amenities (@villa.Amenities.Count())
                            </a>
                        </td>
                        <td class="align-content-center">
                            @if (villa.Latitude != 0 && villa.Longitude != 0)
                            {
                                <a href="https://www.google.com/maps?q=@villa.Latitude,@villa.Longitude"
                                   target="_blank" class="btn btn-sm btn-outline-primary">
                                    View on Map
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No location</span>
                            }
                        </td>
                        <td class="align-content-center">
                            <div class="w-75 btn-group" role="group">
                                <a asp-controller="Villa" asp-action="Update" asp-route-id="@villa.Id"
                                   class="btn btn-success mx-1">
                                    <i class="bi bi-pencil-square"></i> Update
                                </a>
                                <a asp-controller="Villa" asp-action="Delete" asp-route-id="@villa.Id"
                                   class="btn btn-danger mx-1">
                                    <i class="bi bi-trash-fill"></i> Delete
                                </a>
                                <a asp-controller="Floor" asp-action="Create" asp-route-id="@villa.Id"
                                   class="btn btn-primary mx-1 d-flex flex-column align-items-center justify-content-center text-center"
                                   style="min-width: 90px; white-space: nowrap;">
                                    <i class="bi bi-plus-circle mb-1"></i>
                                    Add Floor
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<!-- Villa Amenity Modal -->
<div class="modal fade" id="villaAmenityModal" tabindex="-1" aria-labelledby="villaAmenityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Villa Amenities</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul id="villaAmenityList" class="list-group"></ul>
            </div>
        </div>
    </div>
</div>


<!-- Image Preview Modal -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-0">
            <div class="modal-body p-0">
                <img id="modalImage" src="#" class="w-100" style="object-fit: contain;" />
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        function showFullImage(imgSrc) {
            document.getElementById('modalImage').src = imgSrc;
        }

        function loadVillaAmenities(villaId) {
            const amenityList = document.getElementById("villaAmenityList");
            amenityList.innerHTML = "";

            const villas = @Html.Raw(Json.Serialize(Model.Select(v => new
            {
                id = v.Id,
                name = v.Name,
                amenities = v.Amenities.Select(a => a.Name.Trim())
            })));

            const villa = villas.find(v => v.id === parseInt(villaId));

            if (!villa || !villa.amenities || villa.amenities.length === 0) {
                amenityList.innerHTML = "<li class='list-group-item'>No amenities available for this villa.</li>";
                return;
            }

            villa.amenities.forEach(amenity => {
                const li = document.createElement("li");
                li.className = "list-group-item";
                li.textContent = amenity;
                amenityList.appendChild(li);
            });

            // Update modal title with villa info
            document.querySelector('#villaAmenityModal .modal-title').textContent =
                `Amenities for Villa ${villa.name}`;
        }
    </script>
}

