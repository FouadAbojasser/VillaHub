@{
    ViewData["Title"] = "Email Check";
}

<div class="container pt-5">
    <div class="card shadow border">
        <div class="card-header bg-success bg-gradient py-4">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="py-2 text-white">Reset Password Using Confirmation Link</h2>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-12">
                    <section>
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="text-md-left" style="font-size: 1.1rem;">
                                    A password reset link has been sent to your email address.
                                    <br><br>
                                    Please check your inbox and follow the instructions to reset your password.
                                </div>
                            </div>
                        </div>
                        <div class="text-center">
                            <a href="/Home/Index" class="btn btn-outline-success w-100">Back Home</a>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>
