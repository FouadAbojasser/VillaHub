@{
    ViewData["Title"] = "Email Check";
}

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<div class="container pt-5">
    <div class="card shadow border">
        <div class="card-header bg-success bg-gradient py-4">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="py-2 text-white">@Localizer["Title"]</h2>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-12">
                    <section>
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="text-md-left" style="font-size: 1.1rem;">
                                   @Localizer["CheckYourEmial1"]
                                    <br><br>
                                    @Localizer["CheckYourEmial2"]
                                </div>
                            </div>
                        </div>
                        <div class="text-center">
                            <a href="/Home/Index" class="btn btn-outline-success w-100"> @Localizer["BackHome"]</a>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>
