@using VillaHub.Web.ViewModels
@model ForgotPasswordVM

<div class="container pt-5">
    <div class="card shadow border">
        <div class="card-header bg-success bg-gradient ml-0 py-4">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="py-2 text-white">Reset Password Request</h2>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-12">
                    <section>
                        <form asp-area="Identity" asp-controller="Account" asp-action="ForgotPassword" method="post">
                           
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-floating mb-3">
                                <input asp-for="UserNameOrEmail" class="form-control" aria-required="true" />
                                <label asp-for="UserNameOrEmail" class="form-label"></label>
                                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                            </div>

                            <!-- Password Reset Method Selection -->
                            <div class="form-group">
                                <label>Select reset method *</label><br />
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ResetMethod" id="otpOption" value="OTP_WhatsApp" checked>
                                    <label class="form-check-label" for="otpOption">
                                        Reset password using OTP via WhatsApp
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ResetMethod" id="otpOption" value="OTP">
                                    <label class="form-check-label" for="otpOption">
                                        Reset password using OTP via Email
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ResetMethod" id="linkOption" value="ConfirmationLink">
                                    <label class="form-check-label" for="linkOption">
                                        Reset password using confirmation link
                                    </label>
                                </div>
                            </div>

                            <div class="d-grid gap-3">
                                <button type="submit" class="btn btn-lg btn-outline-success">Request Reset</button>
                                <a href="/" class="btn btn-lg btn-outline-secondary">Cancel</a>
                            </div>
                        </form>
                    </section>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
