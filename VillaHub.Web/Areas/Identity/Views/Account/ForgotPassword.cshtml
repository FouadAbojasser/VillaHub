@{
    ViewData["Title"] = "Forgot Password";
}

@using System.Globalization
@using VillaHub.Web.ViewModels
@using VillaHub.Web.ViewModels.Identity
@using Microsoft.AspNetCore.Mvc.Localization
@model ForgotPasswordVM
@inject IViewLocalizer Localizer

<div class="container pt-5">
    <div class="card shadow border">
        <div class="card-header bg-success bg-gradient ml-0 py-4">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="py-2 text-white">@Localizer["ResetPasswordRequest"]</h2>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-12">
                    <section>
                        <form asp-area="Identity" asp-controller="Account" asp-action="ForgotPassword" method="post">
                           
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-floating mb-3">
                                <input asp-for="UserNameOrEmail" class="form-control" aria-required="true" />
                                <label asp-for="UserNameOrEmail" class="form-label"></label>
                                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                            </div>

                            <!-- Password Reset Method Selection -->
                            <div class="form-group @(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "form-select-rtl" : "")">
                                <label class="mb-2">@Localizer["SelectResetMethod"]</label><br />

                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="radio" name="ResetMethod" id="otpWhatsappOption" value="OTP_WhatsApp" checked>
                                    <label class="form-check-label @(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "ms-2" : "")" for="otpWhatsappOption">
                                        @Localizer["ResetPasswordUsingOTPViaWhatsApp"]
                                    </label>
                                </div>

                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="radio" name="ResetMethod" id="otpEmailOption" value="OTP">
                                    <label class="form-check-label @(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "ms-2" : "")" for="otpEmailOption">
                                        @Localizer["ResetPasswordUsingOTPViaEmail"]
                                    </label>
                                </div>

                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="radio" name="ResetMethod" id="linkOption" value="ConfirmationLink">
                                    <label class="form-check-label @(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "ms-2" : "")" for="linkOption">
                                        @Localizer["ResetPasswordUsingConfirmationLink"]
                                    </label>
                                </div>
                            </div>

                            <div class="d-grid gap-3">
                                <button type="submit" class="btn btn-lg btn-outline-success">@Localizer["RequestReset"]</button>
                                <a href="/" class="btn btn-lg btn-outline-secondary">@Localizer["Cancel"]</a>
                            </div>

                        </form>

                    </section>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
