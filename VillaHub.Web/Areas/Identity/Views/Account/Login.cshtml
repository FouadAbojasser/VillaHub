@using System.Globalization
@using VillaHub.Web.ViewModels
@using VillaHub.Web.ViewModels.Identity
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model LoginVM

@{
    ViewData["Title"] = Localizer["Login"];
}


<div class="container pt-5">
    <div class="card shadow border">
        <div class="card-header bg-success bg-gradient ml-0 py-4">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="py-2 text-white">@Localizer["Login"]</h2>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-12">
                    <section>
                        <!-- Login Form -->
                        <form asp-area="Identity" asp-action="Login" method="post">
                            <input asp-for="RedirectUrl" hidden />
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="form-floating mb-3">
                                <input asp-for="UserNameOrEmail" class="form-control" aria-required="true" />
                                <label asp-for="UserNameOrEmail" class="form-label">@Localizer["UserNameOrEmail"]</label>
                                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Password" class="form-control" aria-required="true" />
                                <label asp-for="Password" class="form-label">@Localizer["Password"]</label>
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="checkbox mb-3">
                                <input class="form-check-input" asp-for="RememberMe" />
                                <label class="form-label @(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "me-1":"ms-1")">@Localizer["RememberMe"]</label>
                            </div>

                            <div class="mb-3">
                                <button type="submit" class="w-100 btn btn-lg btn-outline-success">@Localizer["Login"]</button>
                            </div>
                        </form>

                        <!-- Social Login Buttons -->
                        <div class="d-flex justify-content-between mb-4">
                            <form asp-area="Identity" asp-action="ExternalLogin" asp-controller="Account" method="post" class="w-50 ">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="Google" />
                                <input type="hidden" name="returnUrl" value="@Model.RedirectUrl" />
                                <button type="submit" class="btn btn-outline-danger w-100">
                                    <i class="bi bi-google"></i> @Localizer["Google"]
                                </button>
                            </form>

                            <form asp-area="Identity" asp-action="ExternalLogin" asp-controller="Account" method="post" class="w-50 @(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "me-2" : "ms-2")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="Facebook" />
                                <input type="hidden" name="returnUrl" value="@Model.RedirectUrl" />
                                <button type="submit" class="btn btn-outline-primary w-100">
                                    <i class="bi bi-facebook"></i> @Localizer["Facebook"]
                                </button>
                            </form>
                        </div>

                        <!-- Bottom Links -->
                        <div class="d-flex justify-content-between">
                            <a asp-area="Identity" asp-action="ForgotPassword" asp-controller="Account">@Localizer["ForgotPassword"]</a>
                            <a asp-area="Identity" asp-action="Register" asp-route-returnUrl="@Model.RedirectUrl">@Localizer["RegisterNewUser"]</a>
                            <a asp-area="Identity" asp-action="ResendConfirmEmail" asp-controller="Account">@Localizer["ResendEmailConfirmation"]</a>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}